# Bu dosyayı config/.env olarak kopyalayıp kendi değerlerinizi girin.
# config/.env dosyası .gitignore ile repoya girmez — şifreleri asla commit'lemeyin.

DATA_MODE=csv                     # csv | sql

DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=127.0.0.1,1433
DB_DATABASE=KitapVeritabani

# Windows kimlik doğrulaması için USER/PASSWORD boş bırakın
DB_USER=
DB_PASSWORD=

DB_ENCRYPT=yes
DB_TRUST_SERVER_CERT=yes
